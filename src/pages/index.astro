---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';

const metadata = {
  title: 'Ki的工具筆記 — 發現工具與技能的冒險',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      { text: '關於我', href: '/about' },
      { text: '開始閱讀', href: '#latest-posts' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1717149326204-cbf6009229c5?q=80&w=1887&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
      alt: 'A vintage tungsten bulb Image',
    }}
  >
    <Fragment slot="title">
      歡迎來到 Ki 的工具筆記 📝
      <span class="text-accent dark:text-white highlight"> KiToolkit</span> ！
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">KiToolkit</span> 是一個專注於各種實用工具、技能和個人探索的博客。</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-400">KiToolkit: 一個專注於各種實用工具和技能的博客</span>
      我在這裡分享我對工具的熱愛，無論是學習新技能、編程、遊戲還是日常生活中的小幫手。
    </Fragment>
  </Hero>

  <!-- HighlightedPosts Widget ******* -->

  <BlogLatestPosts id="latest-posts" title="閱讀最新文章" information={`這裡是我最新的文章，希望你會喜歡！`} />
</Layout>
